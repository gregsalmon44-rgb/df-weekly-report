# Demand Flow weekly report — configuration.
# Copy to .env for local runs. Railway gets the same names as service variables.

# ── The master spreadsheet ───────────────────────────────────────────────────
# The Demand Flow master sheet. Read through Google's public CSV export, so no
# API key is needed — but that means the sheet must stay link-readable. If it is
# ever locked down, set GOOGLE_SHEETS_API_KEY and the reader switches to the API.
SHEET_ID=1xjnpjG5qI7fWIP0V70AorZzfDyq5PRpcfuXG2QgUQWk
SHEET_TAB_ROSTER=SMS Schedule View
SHEET_TAB_LEADS=SMS Leads
SHEET_TAB_SMS=SMS Sent Out
# GOOGLE_SHEETS_API_KEY=

# ── Money ────────────────────────────────────────────────────────────────────
# Cost per SMS sent, in dollars. The report's own footnote quotes this value, so
# changing it here changes what the PDF says (OBE's hardcodes the number twice).
SMS_UNIT_COST=0.0070
# The business epoch — "all-time" on the report starts here.
ALL_TIME_START=2026-07-01

# ── Data cost (the Demand Flow ZIP dashboard) ────────────────────────────────
# Per-client data spend. Until the dashboard stores location ids for Demand Flow,
# leave these unset: the report then prints "data cost unavailable" rather than
# silently reporting zero cost and overstating profit.
# PHANTOMDASH_URL=https://phantomdash-production.up.railway.app
# PHANTOMDASH_COST_SECRET=

# ── Database (SMS counter + revenue ledger) ──────────────────────────────────
# Unset locally = SMS falls back to the sheet's "SMS Sent Out" tab and revenue
# reads as unavailable.
# DATABASE_URL=

# ── Slack delivery ───────────────────────────────────────────────────────────
# Posting a PDF needs a bot token (files:write + chat:write); a webhook cannot
# upload files. The bot must be invited to the channel.
# SLACK_BOT_TOKEN=
# SLACK_REPORT_CHANNEL_ID=
# Text-only fallback: raises the alarm in Slack if the Monday post fails.
# SLACK_ALERT_WEBHOOK=

# ── Admin endpoints ──────────────────────────────────────────────────────────
# Shared secret for the manual report/preview endpoints (header x-report-secret).
# ADMIN_SECRET=
PORT=4100


# EASYPAY_SECURITY_KEY=

